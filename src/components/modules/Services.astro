---
import Flag from "@components/partials/Flag.astro";

const slides = [
    {
        title: "Strategie & Konzeption",
        body: `<strong>Strategische Überlegungen</strong> und <strong>konzeptionelle Klarheit</strong> stehen am Anfang meiner Arbeit. Von <em>ersten Ideen</em> bis zur <em>konkreten Ausarbeitung</em> geht es um klare Strukturen, reduzierte Komplexität und eine nachvollziehbare inhaltliche Ausrichtung.`,
        icon: `<svg class="relative -top-10 w-105 h-105 lg:w-130 lg:h-130 mr-30" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 256 256" data-astro-cid-6umjevil=""> <path fill="currentColor" d="M68 152a36 36 0 1 0 36 36a36 36 0 0 0-36-36Zm0 56a20 20 0 1 1 20-20a20 20 0 0 1-20 20ZM34.34 106.34L48.69 92L34.34 77.66a8 8 0 0 1 11.32-11.32L60 80.69l14.34-14.35a8 8 0 0 1 11.32 11.32L71.31 92l14.35 14.34a8 8 0 0 1-11.32 11.32L60 103.31l-14.34 14.35a8 8 0 0 1-11.32-11.32Zm187.32 96a8 8 0 0 1-11.32 11.32L196 199.31l-14.34 14.35a8 8 0 0 1-11.32-11.32L184.69 188l-14.35-14.34a8 8 0 0 1 11.32-11.32L196 176.69l14.34-14.35a8 8 0 0 1 11.32 11.32L207.31 188Zm-45.19-89.51c-6.18 22.33-25.32 41.63-46.53 46.93a8.13 8.13 0 0 1-2 .24a8 8 0 0 1-1.93-15.76c15.63-3.91 30.35-18.91 35-35.68c3.19-11.5 3.22-29-14.71-46.9l-2.3-2.35V80a8 8 0 0 1-16 0V40a8 8 0 0 1 8-8h40a8 8 0 0 1 0 16h-20.69l2.35 2.34c18.24 18.25 24.92 40.44 18.81 62.49Z" data-astro-cid-6umjevil=""></path> </svg>`
    },
    {
        title: "Responsives Webdesign",
        body: `Der Fokus liegt auf <strong>klaren, individuellen Interfaces</strong>, die sich <em>flexibel an unterschiedliche Geräte</em> anpassen und eine <em>konsistente Nutzung</em> ermöglichen.`,
        icon: `<svg class="relative -top-10 w-105 h-105 lg:w-130 lg:h-130 mr-30" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" data-astro-cid-6umjevil=""> <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.5 12c0-4.478 0-6.718 1.391-8.109S7.521 2.5 12 2.5c4.478 0 6.718 0 8.109 1.391S21.5 7.521 21.5 12c0 4.478 0 6.718-1.391 8.109S16.479 21.5 12 21.5c-4.478 0-6.718 0-8.109-1.391S2.5 16.479 2.5 12m0-3h19M13 13h4m-4 4h2M7 6h.009M11 6h.009M9 9v12.5" color="currentColor" data-astro-cid-6umjevil=""></path> </svg>`
    },
    {
        title: "Frontend-Entwicklung",
        body: `In der Frontend-Entwicklung stehen <strong>sauberer, wartbarer Code</strong>, <strong>hohe Performance</strong> und eine <strong>durchdachte Architektur</strong> im Mittelpunkt. Ziel ist eine technische Basis, die <em>stabil</em>, <em>skalierbar</em> und <em>zukunftsfähig</em> bleibt.`,
        icon: `<svg class="relative -top-10 w-105 h-105 lg:w-130 lg:h-130 mr-30" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" data-astro-cid-6umjevil=""> <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" data-astro-cid-6umjevil=""> <path d="M10 17h-.667a2 2 0 0 1-2-2v-1.889C7.333 12.556 6 12 6 12s1.333-.556 1.333-1.111V9a2 2 0 0 1 2-2H10m4 10h.667a2 2 0 0 0 2-2v-1.889C16.667 12.556 18 12 18 12s-1.333-.556-1.333-1.111V9a2 2 0 0 0-2-2H14" data-astro-cid-6umjevil=""></path> <path d="M21 3.6v16.8a.6.6 0 0 1-.6.6H3.6a.6.6 0 0 1-.6-.6V3.6a.6.6 0 0 1 .6-.6h16.8a.6.6 0 0 1 .6.6Z" data-astro-cid-6umjevil=""></path> </g> </svg>`
    },
    {
        title: "SEO-Optimierung",
        body: `Grundlegende SEO-Aspekte werden bei der Umsetzung mitgedacht. Im Fokus stehen <strong>saubere technische Grundlagen</strong>, <em>strukturierte Inhalte</em> und eine <em>nachvollziehbare Informationsarchitektur</em>.`,
        icon: `<svg class="relative -top-10 w-105 h-105 lg:w-130 lg:h-130 mr-30" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" data-astro-cid-6umjevil=""> <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" color="currentColor" data-astro-cid-6umjevil=""> <path d="m5 20l2.413-2.413m0 0a4.444 4.444 0 1 0 6.285-6.285a4.444 4.444 0 0 0-6.285 6.285" data-astro-cid-6umjevil=""></path> <path d="M3 15.188a7.4 7.4 0 0 1-1-3.726C2 7.341 5.358 4 9.5 4h5c4.142 0 7.5 3.341 7.5 7.462c0 3.25-2.087 6.014-5 7.038" data-astro-cid-6umjevil=""></path> </g> </svg>`
    },
    {
        title: "Pflege & Updates",
        body: `Auch nach der initialen Umsetzung spielen <strong>Wartbarkeit</strong>, <strong>Sicherheit</strong> und <strong>technische Weiterentwicklung</strong> eine wichtige Rolle. Regelmäßige Updates und Anpassungen tragen zu stabilen und langfristig nutzbaren Weblösungen bei.`,
        icon: `<svg class="relative -top-10 w-105 h-105 lg:w-130 lg:h-130 mr-30" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 16 16" data-astro-cid-6umjevil=""> <path fill="currentColor" fill-rule="evenodd" d="M1.884 8H3.5a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.492-.41c-.343-1.885-.427-4.735.474-7.14c.453-1.21 1.164-2.33 2.237-3.145C4.797 1.485 6.205 1 8 1c1.796 0 3.204.486 4.282 1.305c1.073.816 1.784 1.934 2.237 3.145c.901 2.405.816 5.255.474 7.14a.5.5 0 0 1-.492.41h-.946c-1.479 1.738-3.713 2.108-5.074 2H7.5a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v.517c.964-.012 2.214-.295 3.217-1.105A.5.5 0 0 1 12 12.5v-4a.5.5 0 0 1 .5-.5h1.615c-.1-.752-.271-1.5-.533-2.2c-.405-1.08-1.02-2.025-1.907-2.699C10.794 2.431 9.606 2 8 2s-2.793.43-3.676 1.101c-.887.674-1.5 1.618-1.906 2.7A10 10 0 0 0 1.884 8" clip-rule="evenodd" data-astro-cid-6umjevil=""></path> </svg>`
    }
];

const totalSlides = slides.length;
const totalLabel = String(totalSlides).padStart(2, '0');
---

<section class="-mt-200 -mb-150 3xl:-mt-[35vh] 3xl:-mb-300" id="services" aria-labelledby="services-title" role="region" data-services data-anchor-check-el="[data-services-sticky]" data-anchor-slide-factor-mobile="0.5">
    <div class="relative h-[350vh] md:h-[600vh]">
        <div class="sticky top-0 h-screen flex items-center overflow-hidden" data-services-sticky>
            <div class="grid w-full">
                <div class="col-span-5 md:col-span-4 md:col-start-2 lg:col-span-8 lg:col-start-3 xl:col-span-6 xl:col-start-4 2xl:col-span-4 2xl:col-start-5">

                    <p class="hidden 2xl:block absolute top-[50%] -translate-y-1/2 left-[5vw] text-112 text-white font-bold tracking-2 mt-32 mb-20 lg:mt-40 lg:mb-30 z-10 opacity-20" data-services-counter aria-live="polite" aria-atomic="true">
                        01 <span class="hidden 3xl:inline-block">/ {totalLabel}</span>
                    </p>

                    <div class="relative z-20 [display:grid]" data-services-slides>
                        {slides.map((slide, index) => (
                            <div
                                class={`col-start-1 row-start-1 opacity-0 pointer-events-none [transition:opacity_500ms_ease] [&.is-active]:opacity-100 [&.is-active]:pointer-events-auto${index === 0 ? ' is-active' : ''}`}
                                data-services-slide
                                data-index={index}
                            >
                                <h2 class="md:flex h2 mb-20 lg:mb-30" id="services-title">
                                    <span set:html={slide.icon}></span>
                                    {slide.title}</h2>
                                <p set:html={slide.body}></p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <nav class="absolute right-0 top-1/2 -translate-y-1/2 flex flex-col p-0" aria-label="Schwerpunkte Navigation">
                {slides.map((slide, index) => (
                    <button
                        class={`flex items-center justify-center w-44 h-44 bg-transparent border-0 cursor-pointer p-0 after:content-[''] after:block after:w-8 after:h-8 after:bg-white after:[transition:background-color_300ms_ease,transform_300ms_ease] [&.is-active]:after:bg-red [&.is-active]:after:scale-150${index === 0 ? ' is-active' : ''}`}
                        data-services-dot
                        data-index={index}
                        aria-label={slide.title}
                        title={slide.title}
                    ></button>
                ))}
            </nav>
        </div>
    </div>
</section>

<script>
    import { lazyLoadWhenIdle } from '@scripts/utils/lazy-load-when-idle';
    lazyLoadWhenIdle(() => import('@scripts/modules/services.js'), {
        selector: '*[data-services]',
        rootMargin: '0px 0px 10% 0px',
        onLoad: ({ services }) => services?.init?.()
    });
</script>